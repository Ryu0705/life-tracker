// LifeTracker.xcconfig - Supabase 接続情報テンプレ
// 1. このファイルを `LifeTracker.xcconfig` にコピー
// 2. SUPABASE_URL / SUPABASE_ANON_KEY を Supabase Dashboard の値で埋める
// 3. Xcode プロジェクトの Configurations (Debug / Release) で
//    "Based on Configuration File" にこのファイルを設定する
// 4. LifeTracker.xcconfig は .gitignore 済 (このテンプレ .example のみ git 管理)

// 値に // が含まれると行コメント扱いになるため、URL の // はエスケープ
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// Info.plist 自動生成 (GENERATE_INFOPLIST_FILE = YES) に流し込む
INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)

// Google でサインイン (GoogleSignIn-iOS)。Google Cloud で作った iOS 用の OAuth クライアントの値を入れる
// - GOOGLE_IOS_CLIENT_ID: iOS 用のクライアント ID (xxxx.apps.googleusercontent.com)。Info.plist の GIDClientID に入る
// - GOOGLE_REVERSED_CLIENT_ID: その逆順 (com.googleusercontent.apps.xxxx)。Info.plist の URL スキームに入る
// どちらかが unset のままなら、アプリは「Google の設定がまだです」と出し、Google の画面を開かない
GOOGLE_IOS_CLIENT_ID = unset
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.unset
